/* ── THEME TOGGLE ── */
.theme-toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 100px;
  padding: 6px 14px 6px 10px;
  cursor: pointer;
  font-family: var(--f-body);
  font-size: 12px;
  font-weight: 500;
  color: rgba(255,255,255,0.75);
  transition: all 0.25s;
  white-space: nowrap;
}
.theme-toggle:hover { background: rgba(0,196,104,0.15); border-color: #00C468; color: #2EE89B; }
.theme-toggle .toggle-track {
  width: 32px; height: 18px; border-radius: 100px;
  background: rgba(255,255,255,0.15);
  position: relative; transition: background 0.25s; flex-shrink: 0;
}
.theme-toggle .toggle-thumb {
  position: absolute; top: 3px; left: 3px; width: 12px; height: 12px;
  border-radius: 50%; background: #fff; transition: transform 0.25s, background 0.25s;
}
html.dark .theme-toggle .toggle-track { background: #00C468; }
html.dark .theme-toggle .toggle-thumb { transform: translateX(14px); background: #060B14; }
html.dark .theme-toggle { color: #2EE89B; border-color: rgba(0,196,104,0.3); }

