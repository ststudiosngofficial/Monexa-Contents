<script>
let activeType = 'all';
let activeFmt = 'all';
let searchTerm = '';

function toggleCard(btn) {
  const card = btn.closest('.day-card');
  if (card) card.classList.toggle('open');
}

function filterType(el) {
  const filter = el.dataset.filter;
  document.querySelectorAll('.legend-item').forEach(i => i.classList.remove('active'));

  if (activeType === filter) {
    activeType = 'all';
  } else {
    activeType = filter;
    el.classList.add('active');
  }
  applyFilters();
}

function filterFormat(el) {
  document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
  el.classList.add('active');
  activeFmt = el.dataset.fmt;
  applyFilters();
}

function filterSearch() {
  const input = document.getElementById('searchInput');
  searchTerm = input ? input.value.toLowerCase() : '';
  applyFilters();
}

function applyFilters() {
  const cards = document.querySelectorAll('.day-card');
  if (!cards.length) return;
  let visible = 0;

  cards.forEach(card => {
    const typeMatch = activeType === 'all' || card.dataset.type === activeType;
    const fmtMatch = activeFmt === 'all' || card.dataset.fmt === activeFmt;
    const text = card.textContent.toLowerCase();
    const searchMatch = !searchTerm || text.includes(searchTerm);

    if (typeMatch && fmtMatch && searchMatch) {
      card.classList.remove('hidden');
      visible++;
    } else {
      card.classList.add('hidden');
    }
  });

  const count = document.getElementById('resultsCount');
  if (count) count.textContent = visible + (visible === 1 ? ' post' : ' posts');
}

function toggleTheme() {
  const html = document.documentElement;
  const isDark = html.classList.toggle('dark');
  const label = document.getElementById('themeLabel');
  if (label) label.textContent = isDark ? 'Light Mode' : 'Dark Mode';
}

function copyCaption(btn) {
  const block = btn.closest('.exp-block');
  const text = block ? block.querySelector('.long-caption') : null;
  if (!text) return;
  navigator.clipboard.writeText(text.textContent.trim()).then(() => {
    const prev = btn.textContent;
    btn.textContent = 'Copied';
    setTimeout(() => { btn.textContent = prev; }, 1500);
  });
}

document.querySelectorAll('.pnav__item').forEach(a => a.addEventListener('click', () => {
  document.querySelectorAll('.pnav__item').forEach(x => x.classList.remove('is-active'));
  a.classList.add('is-active');
}));

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    document.querySelectorAll('.day-card.open').forEach(c => c.classList.remove('open'));
  }
});
</script>
