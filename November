<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Monexa Content Calendar · Nov 23 – Dec 1, 2026</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Poppins:wght@300;400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --ink: #0B1220;
  --ink-soft: #16233A;
  --paper: #EEF3F8;
  --paper-dark: #E2EAF3;
  --cream: #F6F9FB;
  --mint: #00C468;
  --mint-deep: #00A85C;
  --gold: #00C468;
  --gold-light: #2EE89B;
  --gold-pale: rgba(0, 196, 104, 0.16);
  --red: #E05275;
  --green: #00C468;
  --green-light: #2EE89B;
  --blue: #2563EB;
  --blue-light: #4F82F5;
  --muted: #667085;
  --border: rgba(11, 18, 32, 0.12);
  --border-strong: rgba(11, 18, 32, 0.25);
  --pf: #00C468;

  --c-mystery: #0D9488;
  --c-clue: #00A85C;
  --c-break: #E05275;
  --c-guess: #2563EB;
  --c-count: #D97706;

  --f-display: 'Fraunces', Georgia, serif;
  --f-body: 'Poppins', 'Outfit', system-ui, sans-serif;
  --f-mono: 'DM Mono', ui-monospace, monospace;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: var(--f-body);
  background: var(--cream);
  color: var(--ink);
  min-height: 100vh;
  overflow-x: hidden;
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.035'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 9999;
  opacity: 0.6;
}

img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }

/* ── BRAND (text lockup, no logo assets) ── */
.brand-lockup { display: flex; align-items: center; gap: 12px; }
.brand-mark {
  width: 34px; height: 34px; border-radius: 9px; background: var(--mint);
  color: #06281A; font-family: var(--f-display); font-weight: 900; font-size: 19px;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.brand-word { font-family: var(--f-display); font-weight: 900; font-size: 24px; letter-spacing: -0.02em; color: #fff; }

/* ── HEADER ── */
.site-header {
  background: var(--ink);
  color: var(--paper);
  padding: 0 48px;
  position: relative;
  overflow: hidden;
}
.site-header::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, #0B1220, #00C468, #2563EB, #0B1220);
}
.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 0 16px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}
.header-meta {
  font-family: var(--f-mono);
  font-size: 11px;
  color: rgba(255,255,255,0.68);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.hero-section {
  padding: 64px 0 56px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: end;
}
.hero-eyebrow {
  font-family: var(--f-mono);
  font-size: 11px;
  color: var(--gold-light);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.hero-eyebrow::before {
  content: '';
  display: block;
  width: 24px;
  height: 1px;
  background: var(--gold-light);
}
.plat-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.16);
  border-radius: 100px;
  padding: 6px 14px 6px 10px;
  margin-bottom: 22px;
  width: fit-content;
}
.plat-chip svg { width: 15px; height: 15px; fill: var(--gold-light); }
.plat-chip span {
  font-family: var(--f-mono);
  font-size: 10.5px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.72);
}
.hero-title {
  font-family: var(--f-display);
  font-size: clamp(36px, 5vw, 68px);
  font-weight: 900;
  line-height: 0.95;
  letter-spacing: -0.04em;
  color: #ffffff;
  margin-bottom: 24px;
}
.hero-title em { font-style: italic; color: var(--gold-light); }
.hero-desc {
  font-size: 15px;
  font-weight: 300;
  color: rgba(255,255,255,0.74);
  line-height: 1.75;
  max-width: 460px;
}
.hero-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 16px;
  overflow: hidden;
}
.stat-box {
  background: var(--ink-soft);
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  transition: background 0.25s;
}
.stat-box:hover { background: rgba(255,255,255,0.05); }
.stat-num {
  font-family: var(--f-display);
  font-size: 42px;
  font-weight: 900;
  line-height: 1;
  color: var(--gold-light);
}
.stat-label { font-size: 12px; color: rgba(255,255,255,0.66); font-weight: 400; letter-spacing: 0.03em; }

/* ── NAV ── */
.pnav {
  background: var(--paper-dark);
  border-bottom: 1px solid var(--border);
  padding: 10px 48px;
  display: flex;
  align-items: center;
  gap: 8px;
  overflow-x: auto;
  scrollbar-width: thin;
}
.pnav__label {
  font-family: var(--f-mono);
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--muted);
  margin-right: 8px;
  white-space: nowrap;
}
.pnav__item {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border-radius: 100px;
  border: 1px solid var(--border-strong);
  font-size: 13px;
  font-weight: 500;
  color: var(--muted);
  white-space: nowrap;
  transition: 0.2s;
  cursor: pointer;
}
.pnav__item svg { width: 14px; height: 14px; fill: currentColor; }
.pnav__item:hover { border-color: var(--ink); color: var(--ink); }
.pnav__item.is-active { background: var(--pf); border-color: var(--pf); color: #fff; }
.pnav__item.is-active svg { fill: currentColor; }

/* ── LEGEND ── */
.legend-bar {
  background: var(--paper-dark);
  border-bottom: 1px solid var(--border);
  padding: 16px 48px;
  display: flex;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
}
.legend-title {
  font-family: var(--f-mono);
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--muted);
  margin-right: 8px;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  font-weight: 500;
  color: var(--ink);
  cursor: pointer;
  padding: 5px 12px;
  border-radius: 100px;
  border: 1px solid transparent;
  transition: 0.2s;
}
.legend-item:hover, .legend-item.active { background: var(--ink); color: var(--paper); }
.legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

/* ── CONTROLS ── */
.controls-bar {
  background: var(--cream);
  border-bottom: 1px solid var(--border);
  padding: 16px 48px;
  display: flex;
  align-items: center;
  gap: 16px;
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(20px);
}
.search-box { position: relative; flex: 1; max-width: 320px; }
.search-box input {
  width: 100%;
  background: var(--paper);
  border: 1px solid var(--border-strong);
  border-radius: 8px;
  padding: 9px 16px 9px 38px;
  font-family: var(--f-body);
  font-size: 13px;
  color: var(--ink);
  outline: none;
  transition: 0.2s;
}
.search-box input:focus { border-color: var(--gold); box-shadow: 0 0 0 3px var(--gold-pale); }
.search-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--muted);
  width: 15px;
  height: 15px;
}
.filter-chips { display: flex; gap: 8px; flex-wrap: wrap; }
.chip {
  padding: 7px 16px;
  border-radius: 100px;
  border: 1px solid var(--border-strong);
  background: transparent;
  font-family: var(--f-body);
  font-size: 12px;
  font-weight: 500;
  color: var(--muted);
  cursor: pointer;
  transition: 0.2s;
}
.chip:hover { border-color: var(--ink); color: var(--ink); }
.chip.active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.results-count {
  margin-left: auto;
  font-family: var(--f-mono);
  font-size: 11px;
  color: var(--muted);
  letter-spacing: 0.05em;
  white-space: nowrap;
}

/* ── MAIN ── */
.main { padding: 48px 48px 80px; max-width: 1440px; margin: 0 auto; }
.week-block { margin-bottom: 72px; }
.week-label-row { display: flex; align-items: center; gap: 20px; margin-bottom: 28px; }
.week-tag {
  font-family: var(--f-mono);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  background: var(--ink);
  color: var(--gold-light);
  padding: 6px 16px;
  border-radius: 4px;
  white-space: nowrap;
}
.week-theme {
  font-family: var(--f-display);
  font-size: 22px;
  font-weight: 700;
  font-style: italic;
  color: var(--ink);
  opacity: 0.5;
}
.week-line { flex: 1; height: 1px; background: var(--border); }

/* ── CARD GRID ── */
.card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 20px; }

/* ── DAY CARD ── */
.day-card {
  background: var(--paper);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  transition: transform 0.25s, box-shadow 0.25s;
  animation: cardIn 0.4s ease both;
  cursor: pointer;
  position: relative;
  display: flex;
  flex-direction: column;
}
.day-card:hover { transform: translateY(-3px); box-shadow: 0 16px 48px rgba(11,18,32,0.1); }
.day-card.hidden { display: none; }
@keyframes cardIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

.card-color-bar { height: 4px; width: 100%; flex-shrink: 0; }
.card-head { padding: 20px 22px 0; display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.day-num {
  font-family: var(--f-mono);
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 8px;
}
.card-title {
  font-family: var(--f-display);
  font-size: 17px;
  font-weight: 700;
  line-height: 1.3;
  color: var(--ink);
  max-width: 260px;
}
.type-pill {
  flex-shrink: 0;
  font-size: 10px;
  font-weight: 600;
  font-family: var(--f-mono);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 4px;
  white-space: nowrap;
}
.plat-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: var(--f-mono);
  font-size: 9.5px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: var(--paper-dark);
  border: 1px solid var(--border-strong);
  color: var(--muted);
  padding: 4px 9px;
  border-radius: 100px;
  white-space: nowrap;
}
.plat-badge svg { width: 11px; height: 11px; fill: currentColor; }
.card-body { padding: 16px 22px 0; }
.divider { height: 1px; background: var(--border); margin: 14px 0; }
.hashtag-row { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 12px; }
.ht { font-size: 11px; font-family: var(--f-mono); color: var(--gold); font-weight: 400; }
.card-foot { padding: 16px 22px 20px; display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: auto; }
.fmt-meta { font-size: 11px; color: var(--muted); font-family: var(--f-mono); letter-spacing: 0.02em; }
.foot-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; min-width: 0; }
.expand-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  background: none;
  border: 1px solid var(--border-strong);
  border-radius: 6px;
  padding: 6px 14px;
  font-family: var(--f-body);
  font-size: 12px;
  font-weight: 500;
  color: var(--muted);
  cursor: pointer;
  transition: 0.2s;
  flex-shrink: 0;
}
.expand-btn:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.expand-btn svg { width: 12px; height: 12px; transition: transform 0.3s; }
.day-card.open .expand-btn svg { transform: rotate(180deg); }

/* ── EXPANDED ── */
.expanded-panel {
  display: none;
  padding: 0 22px 24px;
  border-top: 1px solid var(--border);
  margin-top: 4px;
  animation: expandIn 0.3s ease both;
}
.day-card.open .expanded-panel { display: block; }
@keyframes expandIn { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
.exp-block { margin-top: 20px; }
.exp-kicker {
  font-family: var(--f-mono);
  font-size: 9px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.exp-kicker::after { content: ''; flex: 1; height: 1px; background: var(--border); }
.script-body {
  font-size: 14px;
  line-height: 1.85;
  color: var(--ink);
  background: var(--paper-dark);
  border-left: 3px solid;
  border-radius: 0 10px 10px 0;
  padding: 16px 18px;
  white-space: pre-line;
}
.long-caption {
  font-size: 13.5px;
  line-height: 1.85;
  color: var(--ink);
  background: var(--paper-dark);
  border-left: 3px solid var(--mint);
  border-radius: 0 10px 10px 0;
  padding: 16px 18px;
  white-space: pre-line;
}
.seo-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.seo-tags b {
  font-family: var(--f-mono);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.02em;
  color: var(--mint-deep);
  background: var(--gold-pale);
  border: 1px solid var(--border);
  border-radius: 100px;
  padding: 4px 10px;
}
.copy-btn {
  font-family: var(--f-mono);
  font-size: 9.5px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  background: none;
  border: 1px solid var(--border-strong);
  border-radius: 5px;
  padding: 3px 10px;
  color: var(--muted);
  cursor: pointer;
  transition: 0.2s;
}
.copy-btn:hover { background: var(--mint-deep); color: #fff; border-color: var(--mint-deep); }

/* ── AD / GRAPHIC CANVAS ── */
.ad-canvas {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  padding: 26px 22px 20px;
  margin: 2px 0 14px;
  background: linear-gradient(145deg, var(--ink) 0%, #16233A 60%, #0E3B2C 100%);
  min-height: 168px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.ad-canvas::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 85% 15%, rgba(0,196,104,0.35), transparent 55%);
  pointer-events: none;
}
.ad-headline {
  font-family: var(--f-display);
  font-weight: 900;
  font-style: italic;
  font-size: 21px;
  line-height: 1.2;
  color: #fff;
  margin: 10px 0 8px;
  position: relative;
  z-index: 1;
}
.ad-sub {
  font-family: var(--f-body);
  font-size: 12.5px;
  line-height: 1.5;
  color: rgba(255,255,255,0.82);
  margin: 0 0 16px;
  position: relative;
  z-index: 1;
}
.ad-wordmark {
  position: absolute;
  bottom: 12px;
  right: 16px;
  z-index: 1;
  font-family: var(--f-display);
  font-weight: 900;
  font-size: 13px;
  letter-spacing: 0.04em;
  color: rgba(255,255,255,0.85);
}

/* ── TYPE STYLES ── */
.t-mystery .card-color-bar { background: var(--c-mystery); }
.t-mystery .type-pill { background: rgba(13,148,136,0.12); color: var(--c-mystery); }
.t-mystery .script-body { border-color: var(--c-mystery); }
.t-mystery .exp-kicker { color: var(--c-mystery); }

.t-clue .card-color-bar { background: var(--c-clue); }
.t-clue .type-pill { background: rgba(0,168,92,0.12); color: var(--c-clue); }
.t-clue .script-body { border-color: var(--c-clue); }
.t-clue .exp-kicker { color: var(--c-clue); }

.t-break .card-color-bar { background: var(--c-break); }
.t-break .type-pill { background: rgba(224,82,117,0.12); color: var(--c-break); }
.t-break .script-body { border-color: var(--c-break); }
.t-break .exp-kicker { color: var(--c-break); }

.t-guess .card-color-bar { background: var(--c-guess); }
.t-guess .type-pill { background: rgba(37,99,235,0.1); color: var(--c-guess); }
.t-guess .script-body { border-color: var(--c-guess); }
.t-guess .exp-kicker { color: var(--c-guess); }

.t-count .card-color-bar { background: var(--c-count); }
.t-count .type-pill { background: rgba(217,119,6,0.12); color: var(--c-count); }
.t-count .script-body { border-color: var(--c-count); }
.t-count .exp-kicker { color: var(--c-count); }

/* ── SECTIONS / LIST CARDS ── */
.section-head { display: flex; align-items: center; gap: 20px; margin-bottom: 26px; }
.section-title {
  font-family: var(--f-display);
  font-size: clamp(24px, 3vw, 34px);
  font-weight: 900;
  letter-spacing: -0.03em;
  color: var(--ink);
}
.section-line { flex: 1; height: 1px; background: var(--border); }

.month-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; margin-bottom: 56px; }
.month-card {
  background: var(--paper);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px;
  transition: 0.25s;
}
.month-card:hover { border-color: var(--ink); transform: translateY(-2px); }
.month-card__week {
  font-family: var(--f-mono);
  font-size: 10px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--mint-deep);
  margin-bottom: 10px;
}
.month-card__theme {
  font-family: var(--f-display);
  font-size: 18px;
  font-weight: 800;
  font-style: italic;
  line-height: 1.25;
  color: var(--ink);
  margin-bottom: 8px;
}
.month-card__note { font-size: 12.5px; line-height: 1.6; color: var(--muted); }
.month-card__note ul { margin: 6px 0 0; padding-left: 16px; }
.month-card__note li { margin: 4px 0; }

.wide-note {
  background: var(--paper);
  border: 1px solid var(--border);
  border-left: 3px solid var(--mint);
  border-radius: 0 14px 14px 0;
  padding: 22px 24px;
  margin-bottom: 56px;
}
.wide-note h3 {
  font-family: var(--f-mono);
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--mint-deep);
  margin-bottom: 12px;
}
.wide-note ul { margin: 0; padding-left: 18px; }
.wide-note li { font-size: 13.5px; line-height: 1.75; color: var(--ink); opacity: 0.85; margin: 6px 0; }
.wide-note b { font-weight: 600; opacity: 1; color: var(--ink); }

/* ── CHECKLIST ── */
.check-list { background: var(--paper); border: 1px solid var(--border); border-radius: 14px; padding: 8px 24px; max-width: 860px; }
.check-list label {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding: 14px 0;
  border-bottom: 1px solid var(--border);
  font-size: 13.8px;
  color: var(--ink);
  cursor: pointer;
}
.check-list label:last-child { border-bottom: none; }
.check-list input { margin-top: 4px; accent-color: var(--mint-deep); width: 16px; height: 16px; cursor: pointer; }

/* ── FOOTER ── */
footer {
